# Copiá este archivo como .env y completá con los datos de tu proyecto Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poner en 1 para apuntar a los emuladores locales (npm run dev:emulator ya lo hace)
VITE_USE_EMULATOR=0
