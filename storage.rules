rules_version = '2';

// Fotos de producto: negocios/{negocioId}/productos/{productoId}.jpg
//
// Estas reglas no pueden preguntarle a Firestore quién es miembro de qué
// negocio: `firestore.exists` existe en el emulador pero no en el Storage real
// ("Function not found"), así que acá solo se puede exigir sesión iniciada y
// que lo que se sube sea una imagen chica.
//
// Lo que protege las fotos de un negocio es que su ruta lleva dos ids
// aleatorios de 20 caracteres (el del negocio y el del producto) que no se
// pueden listar: sin conocerlos no hay forma de llegar al archivo. Los datos
// que de verdad importan —productos, movimientos, miembros— siguen protegidos
// por firestore.rules, que sí verifica la membresía.
service firebase.storage {
  match /b/{bucket}/o {
    match /negocios/{negocioId}/productos/{archivo} {
      allow read: if request.auth != null;

      // Hasta 5 MB: la app achica la foto antes de subirla, así que este tope
      // es para que un error no llene el bucket.
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }
  }
}
