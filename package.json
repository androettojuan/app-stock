{
  "name": "stockia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "VITE_USE_EMULATOR=1 vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "db:seed": "node scripts/seed-emulator.mjs",
    "test:rules": "node scripts/probar-reglas.mjs",
    "test:rules:storage": "node scripts/probar-reglas-storage.mjs",
    "superadmin": "node scripts/alta-superadmin.mjs",
    "capturas": "firebase emulators:exec --only auth,firestore --config firebase.capturas.json --project demo-stockia \"node scripts/capturas.mjs\""
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-admin": "^14.2.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
